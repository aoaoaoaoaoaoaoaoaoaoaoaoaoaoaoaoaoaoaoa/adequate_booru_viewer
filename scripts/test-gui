#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

cargo build --release --locked --bin abv
cargo build --release --locked --package abv-acceptance
cargo run --release --locked --package abv-acceptance -- --smoke --backend x11
cargo build --release --locked --bin abv --features egui-test
cargo run --release --locked --package abv-acceptance -- \
    --artifacts "${ABV_ACCEPTANCE_ARTIFACTS:-/tmp/abv-acceptance-artifacts}"
