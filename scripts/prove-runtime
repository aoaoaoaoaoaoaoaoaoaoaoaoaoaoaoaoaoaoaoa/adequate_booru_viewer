#!/bin/sh
set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

coordinate=${FOUNDRY_COORDINATE:?FOUNDRY_COORDINATE is required}
if [ -n "${FOUNDRY_EVIDENCE_DIR:-}" ]; then
    mkdir -p "$FOUNDRY_EVIDENCE_DIR/diagnostics"
    export ABV_ACCEPTANCE_ARTIFACTS="$FOUNDRY_EVIDENCE_DIR/diagnostics/acceptance"
    export ABV_PORTABILITY_ARTIFACTS="$FOUNDRY_EVIDENCE_DIR/diagnostics/portability"
fi

cargo test --locked \
    --package abv-contract \
    --package abv-portability \
    --package adequate_booru_viewer \
    --all-targets \
    --all-features
cargo run --release --locked --package abv-portability -- lifecycle

case "$coordinate" in
    linux-x86_64-x11-vulkan)
        backend=x11
        ;;
    linux-x86_64-wayland-vulkan)
        backend=wayland
        ;;
    macos-aarch64-metal|macos-x86_64-metal|windows-x86_64-dx12)
        cargo build --release --locked --package adequate_booru_viewer \
            --bin abv --features egui-test
        cargo run --release --locked --package abv-portability -- present
        exit 0
        ;;
    *)
        printf 'unsupported ABV runtime coordinate: %s\n' "$coordinate" >&2
        exit 64
        ;;
esac

cargo build --release --locked --bin abv --features egui-test
cargo build --release --locked --package abv-acceptance
cargo run --release --locked --package abv-acceptance -- \
    --smoke --backend "$backend"
